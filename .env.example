# ==============================================================================
# AI CODE REVIEW - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your secret keys.
# NEVER commit the real .env file into Git / GitHub.
# ==============================================================================

# Flask Settings
SECRET_KEY=replace-with-a-random-flask-secret-key-at-least-32-chars
PORT=5000
FLASK_DEBUG=True

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-key-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration
# In production (Render/Neon/Supabase): postgresql://user:password@hostname:5432/dbname
# If omitted or left blank in development, automatically falls back to local SQLite: sqlite:///ai_code_review.db
DATABASE_URL=

# AI Service (Google Gemini API)
# Obtain your free API key at https://aistudio.google.com/
# If omitted, application runs a rule-based static analyzer fallback so it never breaks during interviews.
GEMINI_API_KEY=

# CORS Configuration
# Set to your deployed frontend domain in production (e.g., https://your-app.vercel.app)
FRONTEND_URL=*
